    <script>
        // ==========================================
        // 1. CONFIGURATION
        // ==========================================
        const SUPABASE_URL = "https://ccjykdpjprjaocglypij.supabase.co";
        // توجه: کلید خود را اینجا جایگزین کنید
        const SUPABASE_KEY = "اینجا_کلید_خود_را_وارد_کنید"; 
        
        let APP_STATE = { cinemas: [], schema: [], radarChart: null };

        const headers = { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}`, 'Content-Type': 'application/json' };

        // ==========================================
        // 2. INITIALIZATION & ROUTING
        // ==========================================
        document.addEventListener('DOMContentLoaded', async () => {
            setupNavigation();
            await fetchAllData();
        });

        function setupNavigation() {
            const items = document.querySelectorAll('.nav-item');
            const views = document.querySelectorAll('.view-section');
            const titles = {
                'dashboard': ['داشبورد تحلیلی شبکه', 'نمای کلی از عملکرد و رتبه‌بندی کیفی سینماها'],
                'profile': ['پروفایل جامع سینما', 'جزئیات ریزنمرات، چک‌لیست‌ها و ظرفیت‌های هر سینما'],
                'evaluate': ['ثبت ارزیابی هوشمند', 'ورود اطلاعات سینما و نمره‌دهی بر اساس پارامترهای مصوب'],
                'settings': ['مدیریت پارامترها و وزن‌ها', 'ویرایش ساختار ارزیابی، شاخص‌ها و ضرایب اهمیت دیتابیس'],
                'backup': ['خروجی و بک‌آپ اطلاعات', 'دریافت نسخه پشتیبان از کل دیتابیس']
            };

            items.forEach(item => {
                item.addEventListener('click', (e) => {
                    e.preventDefault();
                    items.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                    
                    const target = item.getAttribute('data-target');
                    views.forEach(v => v.classList.remove('active-view'));
                    document.getElementById(`view-${target}`).classList.add('active-view');
                    
                    document.getElementById('page-title').innerText = titles[target][0];
                    document.getElementById('page-subtitle').innerText = titles[target][1];

                    // Trigger specific render actions
                    if(target === 'dashboard') renderDashboard();
                    if(target === 'profile') populateProfileSelector();
                    if(target === 'evaluate') renderEvalForm();
                    if(target === 'settings') renderSchemaEditor();
                });
            });
        }

        async function fetchAllData() {
            const status = document.getElementById('connection-status');
            if(SUPABASE_KEY.includes('اینجا')) {
                status.className = "px-5 py-2.5 rounded-full bg-red-50 text-red-600 border border-red-200 text-sm font-bold flex items-center gap-2";
                status.innerHTML = '<i class="bi bi-x-circle-fill text-lg"></i> کلید API وارد نشده است';
                return;
            }

            try {
                // Fetch Schema
                const resS = await fetch(`${SUPABASE_URL}/rest/v1/app_config?key=eq.evaluation_schema`, { headers });
                if(resS.ok) {
                    const data = await resS.json();
                    if(data.length > 0) APP_STATE.schema = data[0].value;
                }

                // Fetch Cinemas
                const resC = await fetch(`${SUPABASE_URL}/rest/v1/cinemas?select=*&order=id.desc`, { headers });
                if(resC.ok) APP_STATE.cinemas = await resC.json();

                status.className = "px-5 py-2.5 rounded-full bg-brand-50 text-brand-600 border border-brand-200 text-sm font-bold flex items-center gap-2";
                status.innerHTML = '<i class="bi bi-check-circle-fill text-lg"></i> متصل به پایگاه داده مرکزی';
                
                renderDashboard();
            } catch (err) {
                status.className = "px-5 py-2.5 rounded-full bg-red-50 text-red-600 border border-red-200 text-sm font-bold flex items-center gap-2";
                status.innerHTML = '<i class="bi bi-wifi-off text-lg"></i> خطای ارتباط با سرور';
            }
        }

        // ==========================================
        // 3. DASHBOARD RENDERER
        // ==========================================
        function renderDashboard() {
            const container = document.getElementById('cinemas-list-container');
            const clist = APP_STATE.cinemas;
            
            if(clist.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-slate-400 font-bold bg-slate-50 rounded-2xl">هیچ سینمایی در دیتابیس ثبت نشده است.</div>`;
                return;
            }

            let totSeats = 0, sumScore = 0, sumEff = 0;
            let html = '';

            clist.forEach(c => {
                const op = parseInt(c.operational_seats) || 0;
                const tot = parseInt(c.total_seats) || 1;
                const eff = ((op / tot) * 100).toFixed(1);
                const score = parseFloat(c.total_score) || 0;
                
                totSeats += op; sumScore += score; sumEff += parseFloat(eff);

                let badge = score >= 4 ? 'bg-brand-100 text-brand-700' : (score >= 3 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700');

                html += `
                <div class="data-row">
                    <div class="flex-[3] flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center text-slate-400 text-2xl"><i class="bi bi-camera-reels"></i></div>
                        <div><h4 class="font-black text-navy text-lg">${c.name}</h4><p class="text-xs font-bold text-slate-400 mt-1"><i class="bi bi-geo-alt-fill"></i> ${c.province} - ${c.city}</p></div>
                    </div>
                    <div class="flex-[2] text-center font-bold text-slate-600"><span class="text-navy">${c.halls}</span> سالن <span class="text-slate-300 mx-2">|</span> <span class="text-navy">${op}</span> صندلی</div>
                    <div class="flex-[2] text-center font-black text-slate-500">${eff}%</div>
                    <div class="flex-[2] text-center"><span class="px-5 py-2 rounded-full font-black text-sm ${badge}">${score.toFixed(2)}</span></div>
                    <div class="flex-[1] text-left">
                        <button onclick="goToProfile(${c.id})" class="w-12 h-12 rounded-full bg-slate-50 text-slate-400 hover:bg-brand-500 hover:text-white transition-colors flex items-center justify-center shadow-sm"><i class="bi bi-arrow-left-short text-3xl"></i></button>
                    </div>
                </div>`;
            });

            container.innerHTML = html;
            document.getElementById('kpi-cinemas').innerText = clist.length;
            document.getElementById('kpi-seats').innerText = totSeats.toLocaleString();
            document.getElementById('kpi-score').innerText = (sumScore / clist.length).toFixed(2);
            document.getElementById('kpi-efficiency').innerText = (sumEff / clist.length).toFixed(1) + '%';
        }

        // ==========================================
        // 4. PROFILE RENDERER
        // ==========================================
        function populateProfileSelector() {
            const sel = document.getElementById('profile-selector');
            sel.innerHTML = '<option value="">-- برای مشاهده، یک سینما را انتخاب کنید --</option>';
            APP_STATE.cinemas.forEach(c => sel.innerHTML += `<option value="${c.id}">${c.name}</option>`);
            
            sel.onchange = (e) => {
                if(e.target.value) renderProfile(parseInt(e.target.value));
                else { document.getElementById('profile-content').classList.add('hidden'); document.getElementById('profile-empty').classList.remove('hidden'); }
            };
        }

        function goToProfile(id) {
            document.querySelector('[data-target="profile"]').click();
            setTimeout(() => { document.getElementById('profile-selector').value = id; renderProfile(id); }, 50);
        }

        function renderProfile(id) {
            const c = APP_STATE.cinemas.find(x => x.id === id);
            if(!c) return;

            document.getElementById('profile-empty').classList.add('hidden');
            document.getElementById('profile-content').classList.remove('hidden');

            document.getElementById('prof-score').innerText = parseFloat(c.total_score).toFixed(2);
            document.getElementById('prof-halls').innerText = c.halls;
            document.getElementById('prof-op').innerText = c.operational_seats;
            document.getElementById('prof-nom').innerText = c.nominal_capacity;
            document.getElementById('prof-shows').innerText = c.daily_shows;

            const evalData = c.evaluation_data || {};
            let axesHtml = '';
            let labels = [], scores = [];

            APP_STATE.schema.forEach((cat, idx) => {
                const catData = evalData[cat.id] || { score: 0, parameters: {} };
                labels.push(cat.name);
                scores.push(catData.score);

                let paramsHtml = '';
                cat.parameters.forEach(p => {
                    const pData = catData.parameters[p.id] || { score: 0, value: '' };
                    paramsHtml += `
                    <div class="flex justify-between items-center py-3 border-b border-slate-100 last:border-0 hover:bg-white rounded-xl px-2 transition-colors">
                        <div class="flex-[3]"><p class="font-bold text-sm text-slate-700">${p.name}</p><p class="text-xs text-slate-400 mt-1">وزن در شاخص: ${p.weight}</p></div>
                        <div class="flex-[3] text-sm text-slate-500 bg-white border border-slate-100 p-2 rounded-xl truncate mx-4" title="${pData.value}">${pData.value || '<span class="text-slate-300">بدون توضیح</span>'}</div>
                        <div class="flex-[1] text-left font-black text-lg text-brand-600 bg-brand-50 px-4 py-1 rounded-full text-center">${pData.score}</div>
                    </div>`;
                });

                axesHtml += `
                <div class="bg-slate-50 rounded-[24px] p-6 border border-slate-100">
                    <div class="flex justify-between items-center mb-4">
                        <h4 class="font-black text-navy flex items-center gap-2"><div class="w-8 h-8 bg-navy text-white rounded-full flex items-center justify-center text-xs">${idx+1}</div> ${cat.name} <span class="text-xs font-bold text-slate-400">(وزن کل: ${cat.weight})</span></h4>
                        <span class="bg-navy text-white px-4 py-1.5 rounded-full text-sm font-black shadow-md">امتیاز محور: ${catData.score.toFixed(2)} / 5</span>
                    </div>
                    <div class="space-y-1">${paramsHtml}</div>
                </div>`;
            });
            document.getElementById('prof-axes-container').innerHTML = axesHtml;

            // رندر چارت راداری
            if(APP_STATE.radarChart) APP_STATE.radarChart.destroy();
            const ctx = document.getElementById('radarChart').getContext('2d');
            APP_STATE.radarChart = new Chart(ctx, {
                type: 'radar',
                data: { labels: labels, datasets: [{ label: 'امتیاز', data: scores, backgroundColor: 'rgba(16, 185, 129, 0.2)', borderColor: '#10b981', pointBackgroundColor: '#064e3b', pointBorderWidth: 3, borderWidth: 3 }] },
                options: { scales: { r: { min: 0, max: 5, ticks: { stepSize: 1, display: false }, grid: { color: '#e2e8f0' }, pointLabels: { font: { family: 'Vazirmatn', size: 12, weight: 'bold' }, color: '#0f172a' } } }, plugins: { legend: { display: false } } }
            });
        }

        // ==========================================
        // 5. DYNAMIC EVALUATION FORM
        // ==========================================
        function renderEvalForm() {
            let html = '';
            APP_STATE.schema.forEach((cat, cIdx) => {
                let paramsHtml = '';
                cat.parameters.forEach(p => {
                    paramsHtml += `
                    <div class="flex gap-6 items-center p-4 bg-slate-50 rounded-[20px] mb-3 border border-slate-100">
                        <div class="flex-[3]"><p class="font-bold text-sm text-navy">${p.name}</p><p class="text-xs text-slate-400 mt-1">ضریب اهمیت در این محور: ${p.weight}</p></div>
                        <div class="flex-[1]"><input type="number" min="0" max="5" step="0.5" value="3" id="ev-sc-${cat.id}-${p.id}" class="w-full text-center font-black text-brand-600 bg-white" placeholder="امتیاز (۰-۵)"></div>
                        <div class="flex-[3]"><input type="text" id="ev-val-${cat.id}-${p.id}" class="w-full text-sm bg-white" placeholder="توضیحات متنی یا چک‌لیست (اختیاری)..."></div>
                    </div>`;
                });
                html += `
                <div class="mb-8">
                    <h4 class="font-black text-lg text-brand-600 mb-4 flex items-center gap-3"><div class="w-10 h-10 bg-brand-100 rounded-[16px] flex items-center justify-center"><i class="bi bi-folder-fill"></i></div> ${cIdx+1}. ${cat.name} <span class="text-sm font-bold text-slate-400">(وزن: ${cat.weight})</span></h4>
                    ${paramsHtml}
                </div>`;
            });
            document.getElementById('eval-dynamic-form').innerHTML = html || '<p class="text-slate-400">ساختاری در دیتابیس یافت نشد.</p>';
        }

        async function submitEvaluation() {
            const name = document.getElementById('ev-name').value;
            if(!name) return alert("ورود نام سینما الزامی است.");

            let total_cinema_score = 0;
            let evalData = {};

            APP_STATE.schema.forEach(cat => {
                evalData[cat.id] = { score: 0, parameters: {} };
                let catScore = 0;
                
                cat.parameters.forEach(p => {
                    const pScore = parseFloat(document.getElementById(`ev-sc-${cat.id}-${p.id}`).value) || 0;
                    const pVal = document.getElementById(`ev-val-${cat.id}-${p.id}`).value;
                    evalData[cat.id].parameters[p.id] = { score: pScore, value: pVal };
                    catScore += (pScore * p.weight);
                });
                evalData[cat.id].score = catScore;
                total_cinema_score += (catScore * cat.weight);
            });

            const data = {
                name: name, province: document.getElementById('ev-prov').value, city: document.getElementById('ev-city').value, address: document.getElementById('ev-address').value,
                halls: parseInt(document.getElementById('ev-halls').value), total_seats: parseInt(document.getElementById('ev-total').value),
                nominal_capacity: parseInt(document.getElementById('ev-nom').value), operational_seats: parseInt(document.getElementById('ev-op').value),
                daily_shows: parseInt(document.getElementById('ev-shows').value), evaluation_data: evalData, total_score: total_cinema_score.toFixed(2)
            };

            try {
                const res = await fetch(`${SUPABASE_URL}/rest/v1/cinemas`, { method: 'POST', headers, body: JSON.stringify(data) });
                if(res.ok) { alert("ارزیابی با موفقیت در دیتابیس ثبت شد!"); await fetchAllData(); document.querySelector('[data-target="dashboard"]').click(); }
                else alert("خطا در ثبت اطلاعات در دیتابیس.");
            } catch (err) { alert("خطای ارتباط با سرور"); }
        }

        // ==========================================
        // 6. SCHEMA EDITOR (SETTINGS)
        // ==========================================
        function renderSchemaEditor() {
            let html = '';
            APP_STATE.schema.forEach((cat, cIdx) => {
                let paramsHtml = '';
                cat.parameters.forEach((p, pIdx) => {
                    paramsHtml += `
                    <div class="flex gap-3 mb-3 items-center pl-10">
                        <i class="bi bi-arrow-return-left text-slate-300 text-xl"></i>
                        <input type="text" value="${p.name}" onchange="upSchema(${cIdx}, ${pIdx}, 'name', this.value)" class="flex-[4] text-sm font-bold bg-white shadow-sm border-none">
                        <div class="flex-[1] relative"><span class="absolute right-3 top-3 text-xs text-slate-400">وزن:</span><input type="number" step="0.05" value="${p.weight}" onchange="upSchema(${cIdx}, ${pIdx}, 'weight', parseFloat(this.value))" class="w-full text-center font-black text-brand-600 bg-white border-none shadow-sm pl-2 pr-10"></div>
                        <button onclick="rmParam(${cIdx}, ${pIdx})" class="w-12 h-12 rounded-full bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-colors flex justify-center items-center"><i class="bi bi-trash-fill"></i></button>
                    </div>`;
                });
                
                html += `
                <div class="bg-slate-50 border border-slate-100 rounded-[32px] p-8 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-2 h-full bg-slate-200 group-hover:bg-brand-400 transition-colors"></div>
                    <div class="flex gap-4 mb-6 items-center bg-white p-4 rounded-[24px] shadow-sm">
                        <div class="w-12 h-12 rounded-[16px] bg-navy text-white flex justify-center items-center font-black text-lg">${cIdx+1}</div>
                        <div class="flex-[4]"><label class="block text-xs font-bold text-slate-400 mb-1 pl-2">نام شاخص اصلی</label><input type="text" value="${cat.name}" onchange="upSchema(${cIdx}, null, 'name', this.value)" class="w-full font-black text-lg border-none bg-slate-50"></div>
                        <div class="flex-[1]"><label class="block text-xs font-bold text-slate-400 mb-1 text-center">وزن کل محور</label><input type="number" step="0.05" value="${cat.weight}" onchange="upSchema(${cIdx}, null, 'weight', parseFloat(this.value))" class="w-full text-center font-black text-xl text-brand-600 bg-brand-50 border-none"></div>
                        <div class="flex-[1] flex gap-2 justify-end mt-5">
                            <button onclick="addParam(${cIdx})" title="افزودن پارامتر زیرمجموعه" class="w-12 h-12 rounded-[16px] bg-blue-50 text-blue-600 hover:bg-blue-600 hover:text-white transition-colors flex items-center justify-center"><i class="bi bi-plus-lg text-xl"></i></button>
                            <button onclick="rmCat(${cIdx})" title="حذف کامل شاخص" class="w-12 h-12 rounded-[16px] bg-red-50 text-red-500 hover:bg-red-500 hover:text-white transition-colors flex items-center justify-center"><i class="bi bi-trash-fill text-xl"></i></button>
                        </div>
                    </div>
                    <div class="space-y-2">${paramsHtml}</div>
                </div>`;
            });
            document.getElementById('schema-editor-container').innerHTML = html;
        }

        const genId = pre => pre + '_' + Math.random().toString(36).substr(2, 6);
        const upSchema = (c, p, k, v) => p === null ? APP_STATE.schema[c][k] = v : APP_STATE.schema[c].parameters[p][k] = v;
        const addParam = c => { APP_STATE.schema[c].parameters.push({ id: genId('p'), name: "پارامتر جدید", weight: 0.1 }); renderSchemaEditor(); }
        const rmParam = (c, p) => { APP_STATE.schema[c].parameters.splice(p, 1); renderSchemaEditor(); }
        const addCategory = () => { APP_STATE.schema.push({ id: genId('cat'), name: "شاخص اصلی جدید", weight: 0.1, parameters: [] }); renderSchemaEditor(); }
        const rmCat = c => { APP_STATE.schema.splice(c, 1); renderSchemaEditor(); }

        async function saveSchemaToDB() {
            try {
                const res = await fetch(`${SUPABASE_URL}/rest/v1/app_config?key=eq.evaluation_schema`, { method: 'PATCH', headers, body: JSON.stringify({ value: APP_STATE.schema }) });
                if(res.ok) alert("ساختار با موفقیت در دیتابیس بروزرسانی شد."); else alert("خطا در ذخیره سازی!");
            } catch (err) { alert("خطای ارتباط!"); }
        }

        // ==========================================
        // 7. BACKUP SYSTEM
        // ==========================================
        function downloadBackup() {
            const pwd = document.getElementById('backup-pwd').value;
            const msg = document.getElementById('backup-msg');
            msg.classList.remove('hidden');
            if(pwd !== "Ma9184364191") { msg.innerText = "❌ رمز عبور اشتباه است. دسترسی غیرمجاز."; msg.className = "text-sm font-bold text-red-500"; return; }
            
            msg.innerText = "✅ احراز هویت موفق. در حال تولید فایل خروجی..."; msg.className = "text-sm font-bold text-brand-600";
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(APP_STATE, null, 2));
            const a = document.createElement('a'); a.href = dataStr; a.download = "BahmanSabz_FullBackup.json"; a.click();
            setTimeout(() => { document.getElementById('backup-pwd').value = ''; msg.classList.add('hidden'); }, 3000);
        }
    </script>
</body>
